# Copiez ce fichier en .env (jamais commité) et remplacez les valeurs.
MYSQL_ROOT_PASSWORD=change_me
# Pour un lancement hors Docker
DB_USERNAME=root
DB_PASSWORD=change_me
# MongoDB : avec Docker, laisser vide (le conteneur mongo-db est utilisé).
# Hors Docker : mongodb://localhost:27017/Ewashing ; Atlas : mongodb+srv://...
MONGODB_URI=
